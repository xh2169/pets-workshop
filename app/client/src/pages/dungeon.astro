---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abyssal Run | Dungeon Demo">
  <div class="py-8">
    <div class="mb-6 max-w-3xl">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.35em] text-violet-300">DUNGEON RUN</p>
      <h1 class="text-4xl font-black text-white md:text-5xl">Abyssal Run</h1>
      <p class="mt-3 text-lg text-slate-300">
        Slash through the ruins, gather the relics, and break the seal before the abyss swallows the tower.
      </p>
    </div>

    <div class="mb-4 flex flex-wrap gap-3 text-sm text-slate-200">
      <span class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1">Move: A / D or ← / →</span>
      <span class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1">Jump: W / ↑ / Space</span>
      <span class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1">Dash: Shift</span>
      <span class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1">Attack: J or K</span>
    </div>

    <div class="overflow-hidden rounded-3xl border border-slate-700 bg-slate-950 shadow-2xl shadow-violet-950/40">
      <canvas id="gameCanvas" width="960" height="540" aria-label="Abyssal Run game" class="block h-auto w-full bg-[#0b1020]"></canvas>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-700 bg-slate-900/70 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-400">Objective</p>
        <p class="mt-2 text-base text-slate-200">Collect all three relics and reach the gate.</p>
      </div>
      <div class="rounded-2xl border border-slate-700 bg-slate-900/70 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-400">Combat</p>
        <p class="mt-2 text-base text-slate-200">Use quick slashes to break enemy patterns. Dash to dodge.</p>
      </div>
      <div class="rounded-2xl border border-slate-700 bg-slate-900/70 p-4">
        <p class="text-xs uppercase tracking-[0.25em] text-slate-400">Status</p>
        <p id="statusText" class="mt-2 text-base text-emerald-300">The tower stirs...</p>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const statusText = document.getElementById('statusText');

    const keys = {};
    const particles = [];

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
    const rectsIntersect = (a, b) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;

    const level = {
      width: 3600,
      height: canvas.height,
      floorY: 490,
      platforms: [
        { x: 0, y: 490, w: 620, h: 60 },
        { x: 700, y: 490, w: 820, h: 60 },
        { x: 1650, y: 490, w: 760, h: 60 },
        { x: 2550, y: 490, w: 600, h: 60 },
        { x: 3000, y: 490, w: 600, h: 60 },
        { x: 340, y: 380, w: 180, h: 18 },
        { x: 760, y: 330, w: 180, h: 18 },
        { x: 1180, y: 370, w: 210, h: 18 },
        { x: 1760, y: 320, w: 170, h: 18 },
        { x: 2140, y: 270, w: 170, h: 18 },
        { x: 2720, y: 340, w: 200, h: 18 },
        { x: 3100, y: 260, w: 200, h: 18 },
      ],
      relics: [
        { x: 530, y: 450, r: 12, collected: false },
        { x: 1765, y: 278, r: 12, collected: false },
        { x: 3160, y: 220, r: 12, collected: false },
      ],
      exit: { x: 3450, y: 390, w: 46, h: 100, unlocked: false },
    };

    const player = {
      x: 120,
      y: 440,
      w: 28,
      h: 42,
      vx: 0,
      vy: 0,
      speed: 4.4,
      jumpForce: 12.5,
      gravity: 0.5,
      face: 1,
      grounded: false,
      canDoubleJump: true,
      health: 5,
      maxHealth: 5,
      invuln: 0,
      attackTimer: 0,
      attackCooldown: 0,
      dashCooldown: 0,
      dashTime: 0,
      hitFlash: 0,
    };

    const enemies = [
      { x: 860, y: 455, w: 28, h: 35, minX: 730, maxX: 1260, vx: 1.3, dir: 1, health: 3, flash: 0 },
      { x: 1700, y: 455, w: 28, h: 35, minX: 1680, maxX: 2160, vx: 1.5, dir: -1, health: 3, flash: 0 },
      { x: 2740, y: 455, w: 28, h: 35, minX: 2585, maxX: 3080, vx: 1.65, dir: 1, health: 3, flash: 0 },
      { x: 3300, y: 455, w: 28, h: 35, minX: 3025, maxX: 3470, vx: 1.3, dir: -1, health: 3, flash: 0 },
    ];

    function spawnBurst(x, y, color, count = 10) {
      for (let i = 0; i < count; i++) {
        particles.push({
          x,
          y,
          vx: (Math.random() - 0.5) * 4,
          vy: (Math.random() - 0.5) * 4,
          life: 18 + Math.random() * 25,
          radius: 2 + Math.random() * 4,
          color,
        });
      }
    }

    function resetPlayer() {
      player.x = 120;
      player.y = 440;
      player.vx = 0;
      player.vy = 0;
      player.grounded = false;
      player.attackTimer = 0;
      player.attackCooldown = 0;
      player.dashCooldown = 0;
      player.dashTime = 0;
      player.invuln = 0;
      player.hitFlash = 0;
    }

    function getAttackBox() {
      const dir = player.face;
      const reachX = dir > 0 ? player.x + player.w : player.x - 30;
      return {
        x: reachX,
        y: player.y + 8,
        w: 34,
        h: 22,
      };
    }

    function applyPlayerDamage(amount, sourceX) {
      if (player.invuln > 0) return;
      player.health = Math.max(0, player.health - amount);
      player.invuln = 0.9;
      player.hitFlash = 0.2;
      const direction = sourceX > player.x ? -1 : 1;
      player.vx = direction * 6;
      player.vy = -4;
      spawnBurst(player.x + player.w / 2, player.y + player.h / 2, '#f87171', 14);

      if (player.health <= 0) {
        statusText.textContent = 'You fell to the abyss...';
        player.health = player.maxHealth;
        setTimeout(() => {
          resetPlayer();
          statusText.textContent = 'The tower stirs again...';
        }, 650);
      }
    }

    function attack() {
      if (player.attackCooldown > 0) return;
      player.attackTimer = 0.18;
      player.attackCooldown = 0.3;
      const attackBox = getAttackBox();
      spawnBurst(player.x + player.w / 2 + player.face * 18, player.y + 20, '#a78bfa', 8);

      for (const enemy of enemies) {
        if (enemy.health <= 0) continue;
        if (rectsIntersect(attackBox, enemy)) {
          enemy.health -= 1;
          enemy.flash = 0.15;
          enemy.x += player.face * 12;
          spawnBurst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#facc15', 10);

          if (enemy.health <= 0) {
            spawnBurst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#34d399', 18);
            statusText.textContent = 'Enemy defeated';
          }
        }
      }
    }

    function triggerDash() {
      if (player.dashCooldown > 0) return;
      player.dashCooldown = 1.1;
      player.dashTime = 0.18;
      player.vx = player.face * 13;
      player.vy *= 0.6;
      spawnBurst(player.x + player.w / 2, player.y + player.h / 2, '#7dd3fc', 12);
    }

    function updatePlayer(dt) {
      const left = keys.a || keys.arrowleft;
      const right = keys.d || keys.arrowright;
      const jump = keys.w || keys.arrowup || keys[' '];
      const dash = keys.shift;

      if (jump && player.grounded) {
        player.vy = -player.jumpForce;
        player.grounded = false;
        player.canDoubleJump = true;
      } else if (jump && !player.grounded && player.canDoubleJump) {
        player.vy = -player.jumpForce * 0.9;
        player.canDoubleJump = false;
      }

      if (!left && !right) {
        player.vx *= 0.8;
      }

      if (left) {
        player.vx -= 0.6;
        player.face = -1;
      }
      if (right) {
        player.vx += 0.6;
        player.face = 1;
      }

      if (dash) {
        triggerDash();
      }

      if (keys.j || keys.k) {
        attack();
      }

      player.vx = clamp(player.vx, -player.speed * (player.dashTime > 0 ? 2.3 : 1), player.speed * (player.dashTime > 0 ? 2.3 : 1));
      player.vy += player.gravity * dt * 60;

      const prevX = player.x;
      const prevY = player.y;

      player.x += player.vx * dt * 60;
      for (const platform of level.platforms) {
        if (rectsIntersect(player, platform)) {
          if (prevX + player.w <= platform.x + 4 && player.vx > 0) {
            player.x = platform.x - player.w;
            player.vx = 0;
          } else if (prevX >= platform.x + platform.w - 4 && player.vx < 0) {
            player.x = platform.x + platform.w;
            player.vx = 0;
          }
        }
      }

      player.y += player.vy * dt * 60;
      player.grounded = false;
      for (const platform of level.platforms) {
        if (rectsIntersect(player, platform)) {
          if (prevY + player.h <= platform.y + 8 && player.vy >= 0) {
            player.y = platform.y - player.h;
            player.vy = 0;
            player.grounded = true;
            player.canDoubleJump = true;
          } else if (prevY >= platform.y + platform.h - 8 && player.vy < 0) {
            player.y = platform.y + platform.h;
            player.vy = 0;
          }
        }
      }

      if (player.y > canvas.height + 120) {
        player.health = 0;
        applyPlayerDamage(5, 0);
      }

      player.attackTimer = Math.max(0, player.attackTimer - dt);
      player.attackCooldown = Math.max(0, player.attackCooldown - dt);
      player.dashCooldown = Math.max(0, player.dashCooldown - dt);
      player.dashTime = Math.max(0, player.dashTime - dt);
      player.invuln = Math.max(0, player.invuln - dt);
      player.hitFlash = Math.max(0, player.hitFlash - dt);

      if (player.x < 0) player.x = 0;
      if (player.x + player.w > level.width) player.x = level.width - player.w;
    }

    function updateEnemies(dt) {
      for (const enemy of enemies) {
        enemy.x += enemy.vx * enemy.dir * dt * 60;
        if (enemy.x < enemy.minX) {
          enemy.x = enemy.minX;
          enemy.dir *= -1;
        }
        if (enemy.x + enemy.w > enemy.maxX) {
          enemy.x = enemy.maxX - enemy.w;
          enemy.dir *= -1;
        }

        enemy.flash = Math.max(0, enemy.flash - dt);

        if (rectsIntersect(player, enemy)) {
          applyPlayerDamage(1, enemy.x);
        }
      }
    }

    function updateRelics() {
      for (const relic of level.relics) {
        if (relic.collected) continue;
        const dx = player.x + player.w / 2 - relic.x;
        const dy = player.y + player.h / 2 - relic.y;
        if (Math.hypot(dx, dy) < 26) {
          relic.collected = true;
          statusText.textContent = 'Relic recovered';
          spawnBurst(relic.x, relic.y, '#67e8f9', 18);
        }
      }

      const collected = level.relics.filter((relic) => relic.collected).length;
      if (collected === level.relics.length) {
        level.exit.unlocked = true;
        statusText.textContent = 'The seal is weakening';
      }

      if (level.exit.unlocked && rectsIntersect(player, level.exit)) {
        statusText.textContent = 'Victory! The abyss yields';
      }
    }

    function drawBackground() {
      const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
      gradient.addColorStop(0, '#0b1120');
      gradient.addColorStop(0.7, '#130d1d');
      gradient.addColorStop(1, '#120b16');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < 30; i++) {
        const x = ((i * 210) - (player.x * 0.15)) % (canvas.width + 200);
        const y = 80 + (i % 7) * 42;
        ctx.fillStyle = 'rgba(255,255,255,0.18)';
        ctx.fillRect(x, y, 2, 2);
      }

      ctx.fillStyle = 'rgba(124, 58, 237, 0.25)';
      for (let i = 0; i < 7; i++) {
        const x = ((i * 300) - (player.x * 0.35)) % (canvas.width + 300);
        ctx.beginPath();
        ctx.moveTo(x, canvas.height);
        ctx.lineTo(x + 140, 160 + (i % 3) * 50);
        ctx.lineTo(x + 300, canvas.height);
        ctx.closePath();
        ctx.fill();
      }
    }

    function drawPlatforms() {
      for (const platform of level.platforms) {
        ctx.fillStyle = '#1e293b';
        ctx.fillRect(platform.x - player.x + 120, platform.y, platform.w, platform.h);
        ctx.fillStyle = '#4f46e5';
        ctx.fillRect(platform.x - player.x + 120, platform.y, platform.w, 6);
      }
    }

    function drawRelics() {
      for (const relic of level.relics) {
        if (relic.collected) continue;
        const x = relic.x - player.x + 120;
        const y = relic.y;
        const glow = 0.7 + Math.sin(performance.now() * 0.006 + relic.x) * 0.3;
        ctx.fillStyle = `rgba(103, 232, 249, ${glow})`;
        ctx.fillRect(x - 4, y - 18, 8, 36);
        ctx.fillStyle = '#7dd3fc';
        ctx.fillRect(x - 9, y - 10, 18, 20);
      }
    }

    function drawExit() {
      const x = level.exit.x - player.x + 120;
      const y = level.exit.y;
      ctx.fillStyle = level.exit.unlocked ? '#34d399' : '#475569';
      ctx.fillRect(x, y, level.exit.w, level.exit.h);
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(x + 10, y + 18, level.exit.w - 20, level.exit.h - 24);
      if (level.exit.unlocked) {
        ctx.fillStyle = '#a7f3d0';
        ctx.fillRect(x + 16, y + 24, level.exit.w - 32, level.exit.h - 36);
      }
    }

    function drawEnemy(enemy) {
      if (enemy.health <= 0) return;
      const x = enemy.x - player.x + 120;
      ctx.fillStyle = enemy.flash > 0 ? '#fca5a5' : '#f87171';
      ctx.fillRect(x, enemy.y, enemy.w, enemy.h);
      ctx.fillStyle = '#111827';
      ctx.fillRect(x + 4, enemy.y + 10, 8, 8);
      ctx.fillRect(x + enemy.w - 12, enemy.y + 10, 8, 8);
    }

    function drawPlayer() {
      const x = player.x - player.x + 120;
      const y = player.y;
      const bodyColor = player.hitFlash > 0 ? '#fca5a5' : '#c4b5fd';

      ctx.fillStyle = bodyColor;
      ctx.fillRect(x, y, player.w, player.h);

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(x + 5, y + 9, 6, 6);
      ctx.fillRect(x + player.w - 11, y + 9, 6, 6);

      ctx.fillStyle = '#e2e8f0';
      const attackBox = getAttackBox();
      if (player.attackTimer > 0) {
        const attackX = attackBox.x - player.x + 120;
        ctx.fillStyle = 'rgba(168, 85, 247, 0.7)';
        ctx.fillRect(attackX, attackBox.y, attackBox.w, attackBox.h);
      }
    }

    function drawParticles() {
      for (const particle of particles) {
        particle.x += particle.vx * 1.5;
        particle.y += particle.vy * 1.5;
        particle.life -= 1;
        ctx.fillStyle = particle.color;
        ctx.globalAlpha = Math.max(particle.life / 40, 0);
        ctx.fillRect(particle.x - player.x + 120, particle.y, particle.radius, particle.radius);
      }
      ctx.globalAlpha = 1;
      particles.splice(0, particles.filter((particle) => particle.life <= 0).length);
    }

    function drawHud() {
      const cameraX = clamp(player.x - 120, 0, level.width - canvas.width + 120);
      ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
      ctx.fillRect(18, 18, 240, 58);
      ctx.fillStyle = '#a78bfa';
      ctx.fillRect(34, 36, 150, 12);
      ctx.fillStyle = '#f87171';
      ctx.fillRect(34, 36, (player.health / player.maxHealth) * 150, 12);
      ctx.fillStyle = '#f8fafc';
      ctx.font = '18px sans-serif';
      ctx.fillText(`HP ${player.health}/${player.maxHealth}`, 34, 62);

      const relicCount = level.relics.filter((relic) => relic.collected).length;
      ctx.fillStyle = '#67e8f9';
      ctx.fillText(`Relics ${relicCount}/${level.relics.length}`, 760, 42);
      ctx.fillStyle = '#e2e8f0';
      ctx.fillText(`x ${Math.round(cameraX)}`, 760, 62);
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawBackground();
      drawPlatforms();
      drawRelics();
      drawExit();
      for (const enemy of enemies) drawEnemy(enemy);
      drawPlayer();
      drawParticles();
      drawHud();
    }

    let last = performance.now();

    function loop(now) {
      const dt = Math.min((now - last) / 1000, 0.024);
      last = now;

      updatePlayer(dt);
      updateEnemies(dt);
      updateRelics();
      draw();
      requestAnimationFrame(loop);
    }

    document.addEventListener('keydown', (event) => {
      const key = event.key.toLowerCase();
      if (['arrowleft', 'arrowright', 'arrowup', ' ', 'shift', 'a', 'd', 'w', 'j', 'k'].includes(key) || ['ArrowLeft', 'ArrowRight', 'ArrowUp', ' '].includes(event.key)) {
        event.preventDefault();
      }
      keys[key] = true;
    });

    document.addEventListener('keyup', (event) => {
      const key = event.key.toLowerCase();
      keys[key] = false;
    });

    resetPlayer();
    requestAnimationFrame(loop);
  </script>
</Layout>
